# Obligatorio. Revoca el token que fue publicado y usa uno nuevo de BotFather.
BOT_TOKEN=1234567890:REEMPLAZA_CON_UN_TOKEN_NUEVO

# El bot es público. Estos IDs solo habilitan comandos administrativos.
OWNER_IDS=123456789
ADMIN_IDS=

# Límites públicos y concurrencia
MAX_FILE_SIZE_MB=10
MAX_BATCH_FILES=40
MAX_BATCH_UNCOMPRESSED_MB=30
RATE_LIMIT_PER_MINUTE=20
BOT_WORKERS=6
HISTORY_LIMIT=20
AUTO_DELETE_SECONDS=0

# Persistencia de metadatos
DATABASE_PATH=./data/codecipherbot.sqlite3
LOG_LEVEL=INFO

# API y panel
WEB_ENABLED=true
WEB_HOST=0.0.0.0
WEB_PORT=8080
PANEL_URL=https://codecipherbot-control.gh0stdeveloper.chatgpt.site
PUBLIC_API_URL=https://api.example.com
CORS_ORIGINS=https://codecipherbot-control.gh0stdeveloper.chatgpt.site
# Recomendado: genera con `python -c "import secrets; print(secrets.token_urlsafe(48))"`
ADMIN_SESSION_SECRET=

# polling para un único proceso; webhook para una URL HTTPS pública
RUN_MODE=polling
WEBHOOK_BASE_URL=
WEBHOOK_PATH_SECRET=
WEBHOOK_HEADER_SECRET=
